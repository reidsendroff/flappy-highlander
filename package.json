{
  "name": "flappy-highlander",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop --project=android --project=iphone",
    "test:production": "npm run build && playwright test --project=production"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
